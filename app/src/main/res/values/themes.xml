<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Використовуємо NoActionBar, щоб тема не створювала свій конфліктуючий ActionBar -->
    <style name="Theme.PhoneHub" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Основні кольори Material3 -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Другорядні кольори Material3 -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Статус-бар -->
        <item name="android:statusBarColor">@color/purple_700</item>
    </style>
</resources>